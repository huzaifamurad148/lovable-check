# Copy these into Railway: your service > Variables.

# Required. Create a key at resend.com > API Keys.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Who receives a notification for every submission (comma-separated for more than one).
NOTIFY_TO=huzaifa.murad@tekrevol.com

# Sender address. Keep the default for testing (it only delivers to the email
# you signed up to Resend with). After verifying tekrevol.com in Resend, use e.g.
# FROM_EMAIL=TekRevol Readiness Check <check@tekrevol.com>
FROM_EMAIL=Lovable Readiness Check <onboarding@resend.dev>

# Set to true ONLY after your sending domain is verified in Resend.
# true  = the prospect gets their full report by email automatically.
# false = the page tells them your team will send it within 6 hours.
SEND_PROSPECT_REPORT=false

# Links used on the page and in emails.
BOOKING_URL=https://calendly.com/your-link
PRIVACY_URL=https://www.tekrevol.com/privacy-policy
# Optional. Leave empty to hide the Terms link in the footer.
TERMS_URL=
